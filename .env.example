# Скопіюй у .env і заповни за потреби. Файл .env у git не потрапляє.

# Куди складати дані застосунку (за замовчуванням ./data)
# PA_DATA_DIR=./data

# Ключ Claude API для AI-функцій (теги, summary, семантичний пошук).
# Без ключа застосунок працює на локальних евристиках.
# ANTHROPIC_API_KEY=sk-ant-...
